{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QChat",
  "version": "1.1.0",
  "identifier": "com.qchat.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://qchat-media.localhost https://images.openai.com; media-src 'self' http://qchat-media.localhost; connect-src ipc: http://ipc.localhost http://qchat-media.localhost",
      "capabilities": [
        "main",
        "bridge",
        "settings"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "ChatGPT one shortcut away",
    "resources": {
      "../packaging/INSTALL.txt": "INSTALL.txt",
      "resources/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
